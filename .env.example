# Environment Variables Example for Parental Control Platform

# Server
SERVER_PORT=8080
ENV=development

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=pc_admin
DB_PASSWORD=pc_secret_db_password_2026
DB_NAME=parental_control_db
DB_SSLMODE=disable

# Redis Cache & PubSub
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=pc_redis_secret_password_2026

# JWT Authentication
JWT_SECRET=018f45a0b9e87d6a5c4b3a2f1e0d9c8b7a654321fedcba0987654321abcdef01
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# WebRTC Coturn STUN & TURN
TURN_STUN_URL=stun:turn.parentalcontrol.local:3478
TURN_URL=turn:turn.parentalcontrol.local:3478
TURN_USERNAME=parentalctl
TURN_CREDENTIAL=SecureTurnSecretPass2026

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your_fcm_server_key_or_credentials_path

# MinIO / S3 Object Storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password_2026
MINIO_USE_SSL=false
MINIO_BUCKET=parental-media
